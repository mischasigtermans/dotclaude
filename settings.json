{
  "fileSuggestion": {
    "type": "command",
    "command": "echo"
  },
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [],
    "defaultMode": "auto"
  },
  "model": "fable",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/bash-guard.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/config-protect.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/ui-gate.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/memory-gate.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/scope-gate.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/php-format.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/dash-lint.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/php-format.py",
            "timeout": 240
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/clauset hook context",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/clauset hook limit",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-wrapper.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "personas@by-mischa": true,
    "steve-jobs@by-mischa": true,
    "raymond-hettinger@by-mischa": true,
    "taylor-otwell@by-mischa": true,
    "david-tolnay@by-mischa": true,
    "ralph@by-mischa": true,
    "security-guidance@claude-plugins-official": true,
    "claude-security@claude-plugins-official": true,
    "library@by-mischa": true,
    "firecrawl@claude-plugins-official": true,
    "laravel-cloud@laravel": true,
    "laravel@laravel": true,
    "laravel-lsp@laravel": true,
    "parley@by-mischa": true,
    "cc-plugin-you-should-know@builtin": true,
    "openseo@openseo": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "by-mischa": {
      "source": {
        "source": "github",
        "repo": "mischasigtermans/by-mischa"
      },
      "autoUpdate": true
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "local": {
      "source": {
        "source": "directory",
        "path": "/Users/Mischa/Github/mischasigtermans"
      }
    },
    "turbopuffer-skills": {
      "source": {
        "source": "github",
        "repo": "turbopuffer/skills"
      }
    },
    "laravel": {
      "source": {
        "source": "github",
        "repo": "laravel/agent-skills"
      }
    },
    "openseo": {
      "source": {
        "source": "github",
        "repo": "every-app/open-seo"
      }
    }
  },
  "feedbackDrafts": "quiet",
  "subagentPromptCacheTtl": "1h",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-fable-5-2": {
      "effortLevel": "medium"
    }
  },
  "advisorModel": "fable",
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md"
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "timeFormat": "24-hour",
  "autoDreamEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "light",
  "editorMode": "normal",
  "verbose": true,
  "precomputeCompactionEnabled": true,
  "switchModelsOnFlag": true,
  "autoContinueAtUsageLimit": true,
  "teammateMode": "in-process",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": false,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Internal sharing / snippet hosting**: None configured: treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured: assume Claude Code runs on an ordinary developer machine with open internet",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured: fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development, personal and admin tasks, and multi-agent orchestration across personal projects",
      "**Org-specific CLIs**: forge, herd, rtk, firecrawl, ykman, profiles: personal tooling observed in usage, not org-mandated"
    ]
  }
}
