#!/bin/sh
# Starts a reviewer's CLI in an environment of its own, so it loads nothing of the user's setup:
# no shell profile, no memory, and only the variables passed on below.
# Codex and Grok get an empty home folder. Claude signs in through the real home's keychain, so it
# keeps that home and leaves out the user's settings, MCP servers and the instruction files in ~/.claude.
# Usage: seat codex|grok <home folder> [arguments for the cli]
#        seat claude [arguments for the cli]
set -eu

cli=$1
shift

case "$cli" in
  claude)
    set -- HOME="$HOME" CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 \
      claude --setting-sources project,local --strict-mcp-config \
      --settings "{\"claudeMdExcludes\":[\"$HOME/.claude/**\"]}" "$@"
    ;;
  *)
    home=$1
    shift
    mkdir -p "$home"
    set -- HOME="$home" ZDOTDIR="$home" \
      GROK_HOME="${GROK_HOME:-$HOME/.grok}" GROK_MEMORY=0 \
      CODEX_HOME="${CODEX_HOME:-$HOME/.codex}" \
      RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.rustup}" CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}" \
      "$cli" "$@"
    ;;
esac

exec env -i \
  PATH="$PATH" \
  TERM="${TERM:-xterm-256color}" \
  COLORTERM="${COLORTERM:-}" \
  LANG="${LANG:-en_US.UTF-8}" \
  USER="$USER" \
  LOGNAME="${LOGNAME:-$USER}" \
  SHELL="${SHELL:-/bin/sh}" \
  TMPDIR="${TMPDIR:-/tmp}" \
  "$@"
